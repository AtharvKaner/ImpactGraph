# ==============================================================================
# ImpactGraph Backend - Environment Configuration Example
# Copy this file to .env (or set these system environment variables)
# NEVER commit your actual .env file or sensitive credentials to Git.
# ==============================================================================

# Database Connection (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=impactgraph
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# Alternatively, specify the full Spring datasource URL:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/impactgraph
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_secure_password_here
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Server Port (optional, defaults to 8080)
PORT=8080

# CORS Allowed Origins (comma-separated, defaults to frontend dev ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT Authentication (HS512 secret: at least 64 characters long)
JWT_SECRET=your_minimum_64_character_super_secret_jwt_signing_key_for_impactgraph_local_dev
JWT_EXPIRATION_MS=86400000

# Administrator Account Bootstrap
ADMIN_BOOTSTRAP_EMAIL=admin@impactgraph.io
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword123!

# GitHub Webhook Integration (HMAC-SHA256 signature verification)
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Remediation guidance is deterministic and offline; no external AI API is used.
AI_PROVIDER=deterministic

