# ==============================================================================
# ImpactGraph - Root Git Ignore
# Covers Backend (Maven/Java), Frontend (Vite/Node/React), IDEs, OS, and Secrets
# ==============================================================================

# Node / Frontend
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Java / Maven Backend
backend/target/
backend/build/
*.class
*.jar
*.war
*.ear
backend/.mvn/wrapper/maven-wrapper.jar

# Secrets, Environment Files & Credentials
.env
.env.*
!.env.example
*.local
credentials.json
secrets.properties
*.pem
*.key
*.p12

# IDEs & Editors
.idea/
*.iml
*.iws
*.ipr
.vscode/
!.vscode/extensions.json
.settings/
.project
.classpath
.factorypath
.sts4-cache
.apt_generated
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Logs
logs/
*.log
