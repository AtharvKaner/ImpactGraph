# =============================================================================
# ImpactGraph — Required Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- PostgreSQL Database ---
DB_NAME=impactgraph
DB_URL=jdbc:postgresql://localhost:5432/impactgraph
DB_USERNAME=impactgraph
DB_PASSWORD=your_database_password_here

# --- JWT Signing Secret ---
# Must be at least 64 characters. Generate with:
#   openssl rand -base64 64
# NEVER reuse across environments. NEVER commit the real value.
JWT_SECRET=REPLACE_WITH_A_RANDOM_STRING_OF_AT_LEAST_64_CHARACTERS_GENERATED_BY_OPENSSL

# --- JWT Token Expiration (milliseconds) ---
# Default: 86400000 (24 hours)
JWT_EXPIRATION_MS=86400000

# --- CORS Allowed Origins ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Admin Bootstrap (OPTIONAL — first-time setup only) ---
# Set these to create the initial admin account on first startup.
# REMOVE these values after the admin account is created.
ADMIN_BOOTSTRAP_EMAIL=admin@yourcompany.com
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD_AT_LEAST_8_CHARS
